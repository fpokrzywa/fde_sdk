# These are templates; Settings reads exported SHIFDE_* variables, not this file.
SHIFDE_DEVELOPMENT=true
SHIFDE_DATABASE_URL=postgresql+psycopg://shifde_runtime:replace-me@127.0.0.1:5432/shifde
SHIFDE_PUBLIC_URL=https://delivery.example
SHIFDE_API_AUDIENCE=https://delivery.example
SHIFDE_MCP_AUDIENCE=https://delivery.example/mcp
SHIFDE_AUTH_ISSUER=https://your-identity-provider.example/
SHIFDE_AUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
SHIFDE_TEMPORAL_ADDRESS=127.0.0.1:7233
SHIFDE_TEMPORAL_TLS=false
SHIFDE_ARTIFACT_ROOT=.shifde/hosted-artifacts
# Export the same registry to API/MCP/workers; export actual native secrets ONLY to execution workers.
SHIFDE_CREDENTIAL_BINDINGS={"workspace-dev":{"tenant_id":"11111111-1111-4111-8111-111111111111","host":"https://your-workspace.cloud.databricks.com","require_approval":true,"mode":"oauth_env","client_id_env":"WORKSPACE_CLIENT_ID","client_secret_env":"WORKSPACE_CLIENT_SECRET"}}
